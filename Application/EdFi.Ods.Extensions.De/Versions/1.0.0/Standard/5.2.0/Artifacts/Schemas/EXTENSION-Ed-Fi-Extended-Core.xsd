            </xs:annotation>
          </xs:element>
          <xs:element name="FractionOfYearOffered" type="EXTENSION-FractionOfYearOffered" minOccurs="0">
            <xs:annotation>
              <xs:documentation>The fraction of a year for the Coop or DO student (i.e. 1.0 for full year, .50 for half year).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="MinutesPerWeekAverage" type="EXTENSION-MinutesPerWeekAverage" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the minutes per week the course meets.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="UnitCountExceptionSchoolReference" type="SchoolReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Identifes school with a unit count exception.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-StudentHealthAlert">
    <xs:annotation>
      <xs:documentation>Defines the codes that describe a person's known medical conditions.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="ComplexObjectType">
        <xs:sequence>
          <xs:element name="StudentReference" type="StudentReferenceType">
            <xs:annotation>
              <xs:documentation>The person receiving the medical screening.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="EducationOrganizationReference" type="EducationOrganizationReferenceType">
            <xs:annotation>
              <xs:documentation>The educational organization accountable for a student's health information.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="HealthAlertCategory" type="EXTENSION-HealthAlertCategoryDescriptorReferenceType">
            <xs:annotation>
              <xs:documentation>Identifies the medical alert code.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-HealthAlertCategoryDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="StartDate" type="xs:date">
            <xs:annotation>
              <xs:documentation>Identifies the start date of a medical alert.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="EndDate" type="xs:date" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Identifies the end date for a medical alert.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Sequence" type="EXTENSION-Sequence" minOccurs="0">
            <xs:annotation>
              <xs:documentation>The sequence number for prioritizing medical alerts.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Comment" type="Comment" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Additional information provided by the responder about the question in the survey.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Instructions" type="EXTENSION-Instructions" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Alert instructions.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
