<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://ed-fi.org/5.2.0" xmlns:ann="http://ed-fi.org/annotation" targetNamespace="http://ed-fi.org/5.2.0" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:include schemaLocation="Ed-Fi-Core.xsd" />
  <xs:annotation>
    <xs:documentation>===== Ed-Fi 5.2.0 Extensions =====</xs:documentation>
  </xs:annotation>
  <xs:annotation>
    <xs:documentation>===== Domain Entities =====</xs:documentation>
  </xs:annotation>
  <xs:complexType name="EXTENSION-ClassPeriodExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="ClassPeriod">
        <xs:sequence>
          <xs:element name="AttendancePeriodOrder" type="xs:int" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Number indicating the order that the period should be listed.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Description" type="Description" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Description of the attendance period.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-ContactExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="EXTENSION-ContactRestriction">
        <xs:sequence>
          <xs:element name="Address" type="EXTENSION-AddressExtension" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Indicates some of the address characteristics like Primary, validated etc..</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-ContactRestriction">
    <xs:annotation>
      <xs:documentation>Restriction to Contact for replacement of common type with common type extension</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:restriction base="Contact">
        <xs:sequence>
          <xs:element name="ContactUniqueId" type="UniqueId">
            <xs:annotation>
              <xs:documentation>A unique alphanumeric code assigned to a contact.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Name" type="Name">
            <xs:annotation>
              <xs:documentation>Full legal name of the person.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="OtherName" type="OtherName" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Other names (e.g., alias, nickname, previous legal name) associated with a person.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Sex" type="SexDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>A person's birth sex.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>SexDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="GenderIdentity" type="GenderIdentity" minOccurs="0">
            <xs:annotation>
              <xs:documentation>The gender the contact identifies themselves as.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="InternationalAddress" type="InternationalAddress" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>The set of elements that describes an international address.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Telephone" type="Telephone" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>The 10-digit telephone number, including the area code, for the person.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ElectronicMail" type="ElectronicMail" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>The numbers, letters, and symbols used to identify an electronic mail (e-mail) user within the network to which the individual or organization belongs.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="LoginId" type="IdentificationCode" minOccurs="0">
            <xs:annotation>
              <xs:documentation>The login ID for the user; used for security access control interface.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Language" type="Language" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>The language(s) the individual uses to communicate. It is strongly recommended that entries use only ISO 639-2 language codes.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="PersonReference" type="PersonReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Relates the contact to a generic person.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="HighestCompletedLevelOfEducation" type="LevelOfEducationDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>The extent of formal instruction an individual has received (e.g., the highest grade in school completed or its equivalent or the highest degree received).</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>LevelOfEducationDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-DisciplineActionExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DisciplineAction">
        <xs:sequence>
          <xs:element name="DisciplineActionPlacementType" type="EXTENSION-DisciplineActionPlacementTypeDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>aditional discipline action information</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-DisciplineActionPlacementTypeDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-RestraintEventExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="RestraintEvent">
        <xs:sequence>
          <xs:element name="AdditionalDetail" type="EXTENSION-Detail" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the additional detail regrading the restraint seclusion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="BehaviorDuringRestraintDetail" type="EXTENSION-Detail" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the detail regrading the behaviour during the restraint seclusion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ChangeDescription" type="Description" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the description of changes for the restraint seclusion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ConsecutiveRestraintCount" type="xs:int" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the number of times a restraint secluson event occurred in a day.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DeescalationTechnique" type="EXTENSION-DeescalationTechniqueDescriptorReferenceType">
            <xs:annotation>
              <xs:documentation>Indicates the detail of the de-escalation technique used in the restraint seclusion event.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-DeescalationTechniqueDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="EventTime" type="xs:time">
            <xs:annotation>
              <xs:documentation>An indication of the time of day the event occurred.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="IncidentLocation" type="IncidentLocationDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Identifies where the restraint seclusion event occurred.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>IncidentLocationDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="NonViolentTechnique" type="EXTENSION-NonViolentTechniqueDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the non violent technique detail regrading the restraint seclusion event.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-NonViolentTechniqueDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="NotificationMethod" type="EXTENSION-NotificationMethodDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the method of notification used for notifying parent or guardian about the restraint secluson event.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-NotificationMethodDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="ParentGuardianNotified" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates if the parent or guradian was notified about the restarint secluson event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ParentGuardianNotifiedDate" type="xs:date" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the date on which the parent or guardian was notified.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ParentGuardianNotifiedTime" type="xs:time" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the time of day the parent or guardian was notified about the restarint secluson event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="PolicyChangeDetail" type="EXTENSION-Detail" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the policy Change detail regrading the restraint seclusion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="PriorToEventDetail" type="EXTENSION-Detail" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the event details prior to the restraint seclusion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="RestraintDuration" type="TimeInterval" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the length in minutes of the restarint secluson event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="RestraintEventCategory" type="EXTENSION-RestraintEventCategoryDescriptorReferenceType">
            <xs:annotation>
              <xs:documentation>Indicates the type of the restraint or seclusion performed.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-RestraintEventCategoryDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="RestraintReportDate" type="xs:date" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the date on which the restraint secluson event was reported.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="StaffTrainingDetail" type="EXTENSION-Detail" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the traing detail for staff involved in restraint seclusion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="StudentInjured" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates if student was injured during the restarint secluson event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="StudentInterviewDetail" type="EXTENSION-Detail" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the student interview detail regrading the restraint seclusion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="StudentTreatment" type="EXTENSION-TreatmentDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the treatment provided to student injured during restarint secluson event.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-TreatmentDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="SupportPlanChange" type="EXTENSION-SupportPlanChangeDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the type of support plan change.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-SupportPlanChangeDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="UsedCrisisResponseTeam" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates if crisis response team was used during the restarint secluson event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="WitnessInterviewDetail" type="EXTENSION-Detail" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the witness interview detail regrading the restraint seclusion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="StaffParticipation" type="EXTENSION-StaffParticipation" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Identifies the staff responsible for providing restarint.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-SectionExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="Section">
        <xs:sequence>
          <xs:element name="AveragePassTimeMinutesPerWeek" type="EXTENSION-AveragePassTimeMinutesPerWeek" minOccurs="0">
            <xs:annotation>
